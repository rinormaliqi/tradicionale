# ---- Site URL (SEO) ----
# Your public production URL — used for canonical links, sitemap, robots and
# structured data. Set this in Vercel to your real domain once you have one.
# If unset, the app falls back to the Vercel deployment URL, then localhost.
# NEXT_PUBLIC_SITE_URL=https://tradicionale.example.com

# ---- Admin login ----
# The password to enter at /admin/login
ADMIN_PASSWORD=change-this-password
# A long random string used to sign the admin session cookie.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=change-this-to-a-long-random-string

# ---- Database (Turso) ----
# Leave BOTH unset for local development (uses a local file at data/tradicionale.db).
# In production (Vercel), set both from your Turso database:
#   turso db show tradicionale --url        -> TURSO_DATABASE_URL
#   turso db tokens create tradicionale     -> TURSO_AUTH_TOKEN
# TURSO_DATABASE_URL=libsql://your-db-name-you.turso.io
# TURSO_AUTH_TOKEN=your-token-here
